{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".DS_Store",
      "**/.DS_Store",
      "**/node_modules/**",
      "LES-MEG.md",
      "Strykeduett.no.pdf",
      "Strykeduett.JPG",
      "Fiolinist.jpg",
      "leacello.jpg",
      "favicon-256.png",
      "favicon-32.png",
      "Logo/Logo.png",
      "Logo/Logomedhode.png",
      "Logo/logo-ordmerke-hvit.png",
      "Logo/logo-ordmerke-krem.png",
      "Logo/logo-ordmerke-transparent.png",
      "Logo/logo-symbol-transparent.png",
      "README.md",
      "pris-1.jpg"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/kontakt.html",
        "destination": "/book-oss.html",
        "type": 301
      },
      {
        "source": "/anledninger.html",
        "destination": "/book-oss.html",
        "type": 301
      },
      {
        "source": "/repertoar.html",
        "destination": "/book-oss.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      }
    ]
  }
}
